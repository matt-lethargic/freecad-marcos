# -*- coding: utf-8 -*-
"""
Voronoi Cutout
==============

Select ONE planar face on a solid, run this macro, fill in the parameters,
and a Voronoi cell pattern is cut into the solid through that face.

Inside a PartDesign Body the cut is added as a feature after the tip, so it
stays in the body's tree and can be edited later through its properties.
Elsewhere it is a Part feature with the original object nested under it.

The geometry and the feature live in voronoi_cutout.py, installed as an addon
by linking the repo into FreeCAD's user Mod folder (see the README). It has to
be there rather than in the Macro folder: FreeCAD 1.1 only re-imports feature
modules from its own tree or from Mod when a document is reopened.
"""

__Name__ = "Voronoi Cutout"
__Comment__ = "Cut a Voronoi cell pattern into a solid through a selected planar face"
__Author__ = "matt-lethargic"
__Version__ = "0.2.0"
__Date__ = "2026-11-22"
__License__ = "MIT"
__Web__ = "https://github.com/matt-lethargic/freecad-marcos"
__Files__ = "voronoi_cutout.py"

import importlib

import FreeCAD as App
import FreeCADGui as Gui

try:
    import voronoi_cutout
except ImportError:
    from PySide import QtWidgets
    QtWidgets.QMessageBox.warning(
        None, "Voronoi Cutout",
        "voronoi_cutout.py was not found. Link the repo into FreeCAD's user Mod folder "
        "(see the README), restart FreeCAD, then run the macro again.")
    raise
importlib.reload(voronoi_cutout)  # pick up edits without restarting FreeCAD

PARAM_PATH = "User parameter:BaseApp/Preferences/Macros/VoronoiCutout"


def load_params():
    grp = App.ParamGet(PARAM_PATH)
    params = {}
    for key, default in voronoi_cutout.DEFAULTS.items():
        if isinstance(default, int):
            params[key] = grp.GetInt(key, default)
        elif isinstance(default, str):
            params[key] = grp.GetString(key, default)
        else:
            params[key] = grp.GetFloat(key, default)
    return params


def save_params(params):
    grp = App.ParamGet(PARAM_PATH)
    for key, value in params.items():
        if isinstance(value, int):
            grp.SetInt(key, value)
        elif isinstance(value, str):
            grp.SetString(key, value)
        else:
            grp.SetFloat(key, float(value))


def selected_faces():
    """Returns (object, [face names]) for the selected planar faces, all on one object."""
    selection = Gui.Selection.getSelectionEx()
    objects = []
    names = []
    for sel in selection:
        obj = sel.Object
        if obj.TypeId == "PartDesign::Body":
            obj = obj.Tip
        for name in sel.SubElementNames:
            name = name.split(".")[-1]
            if name.startswith("Face"):
                if obj not in objects:
                    objects.append(obj)
                if name not in names:
                    names.append(name)
    if not names:
        raise ValueError("Select one or more faces on a solid, then run the macro.")
    if len(objects) != 1:
        raise ValueError("All selected faces must belong to the same object.")
    obj = objects[0]
    if obj is None or not hasattr(obj, "Shape") or obj.Shape.isNull():
        raise ValueError("The selected object has no shape.")
    if not obj.Shape.Solids:
        raise ValueError("The selected object is not a solid.")
    for name in names:
        try:
            voronoi_cutout.planar_surface(obj.Shape.getElement(name))
        except ValueError as err:
            raise ValueError("%s: %s" % (name, err))
    return obj, names


def report_error(message):
    App.Console.PrintError("Voronoi Cutout: %s\n" % message)
    from PySide import QtWidgets
    QtWidgets.QMessageBox.warning(None, "Voronoi Cutout", message)


def main():
    try:
        obj, face_names = selected_faces()
    except ValueError as err:
        report_error(str(err))
        return

    params = voronoi_cutout.ask_params(load_params())
    if params is None:
        return
    save_params(params)

    doc = obj.Document
    doc.openTransaction("Voronoi cutout")
    try:
        feature = voronoi_cutout.create(obj, face_names, params, doc)
    except Exception as err:  # surface anything OCC throws
        doc.abortTransaction()
        report_error(str(err))
        return
    doc.commitTransaction()

    if feature.Shape.isNull() or not feature.isValid():
        report_error("The cut failed to recompute. Check the report view for details.")
        return

    tool = getattr(feature, "AddSubShape", None) or getattr(feature, "Cutter", None)
    cells = len(tool.Solids) if tool is not None else 0
    App.Console.PrintMessage(
        "Voronoi Cutout: cut %d cells into %s through %d face(s)\n"
        % (cells, obj.Label, len(face_names))
    )


main()
